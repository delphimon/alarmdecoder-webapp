# AlarmDecoder Modern — Environment Configuration
# Copy to /etc/alarmdecoder-modern/alarmdecoder-modern.env and edit before first run.

# ---------- Device Adapter ----------
# Adapter type: fake | ser2sock | serial | ad2usb | ad2pi | ad2serial
# Use 'fake' for development/testing without hardware.
ALARMDECODER_ADAPTER=ser2sock

# ser2sock / network adapter settings (used when ADAPTER=ser2sock)
ALARMDECODER_SER2SOCK_HOST=alarmdecoder.local
ALARMDECODER_SER2SOCK_PORT=10000
ALARMDECODER_SER2SOCK_TLS=false

# Local serial adapter settings (used when ADAPTER=serial|ad2usb|ad2pi|ad2serial)
# Ensure the service user is in the 'dialout' group: usermod -aG dialout alarmdecoder-modern
ALARMDECODER_SERIAL_PATH=/dev/ttyUSB0
ALARMDECODER_SERIAL_BAUDRATE=115200

# ---------- Panel ----------
# Panel protocol type: ADEMCO (Honeywell/Resideo Vista) or DSC
ALARMDECODER_PANEL_TYPE=ADEMCO

# ---------- Safety ----------
# Read-only mode: true disables all command sending regardless of other settings.
# ALWAYS start with true for the first hardware connection.
ALARMDECODER_READ_ONLY=true

# Allow sending commands to the panel (arm, disarm, etc.).
# Requires READ_ONLY=false AND a panel PIN configured in settings.
ALARMDECODER_ALLOW_COMMANDS=false

# ---------- Authentication ----------
# Require login to access the dashboard. Strongly recommended for any network deployment.
ALARMDECODER_AUTH_REQUIRED=true

# ---------- Data ----------
ALARMDECODER_DATA_DIR=/var/lib/alarmdecoder-modern
ALARMDECODER_DATABASE_URL=sqlite:////var/lib/alarmdecoder-modern/alarmdecoder-modern.db

# ---------- Security ----------
# REQUIRED: Replace with a long random string (>= 32 characters).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# WARNING: Rotating this value will invalidate all sessions AND any encrypted panel PIN.
ALARMDECODER_SESSION_SECRET=change-this-long-random-secret

# ---------- Retention ----------
ALARMDECODER_RAW_RETENTION_DAYS=14
ALARMDECODER_EVENT_RETENTION_DAYS=90

# ---------- Command Safety ----------
# Minimum seconds between consecutive panel commands (prevents accidental rapid-fire).
ALARMDECODER_COMMAND_COOLDOWN_SECONDS=1.5

# ---------- Logging ----------
# Log level: debug | info | warning | error
ALARMDECODER_LOG_LEVEL=info

# ---------- CORS (optional, for nginx reverse proxy) ----------
# Comma-separated list of allowed origins for API access. Leave empty for default (localhost only).
ALARMDECODER_CORS_ORIGINS=
